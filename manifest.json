{
  "manifest_version": 3,
  "name": "JobApply Autofill (MVP)",
  "version": "0.1.0",
  "description": "Autofills job application forms from your saved profile using Jev field classification.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Autofill this application"
  },
  "options_page": "options/options.html"
}
