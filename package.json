{
  "name": "job-autofill-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chrome extension that autofills job application forms. No network calls, no telemetry.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev --watch"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
